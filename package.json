{
  "name": "amentoi-cli",
  "version": "0.4.0",
  "description": "api2cli-based CLI for Amen Toi services with one account API key",
  "type": "module",
  "bin": { "amentoi-cli": "./dist/index.js", "amentoi": "./bin/amentoi.js" },
  "files": ["bin", "dist", "src", "skills", "README.md", "tsconfig.json"],
  "engines": { "bun": ">=1.2.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node --check bin/amentoi.js",
    "test": "bun run build && node --test",
    "build": "bun build src/index.ts --outfile dist/index.js --target bun"
  },
  "dependencies": { "commander": "^13.0.0", "picocolors": "^1.1.0" },
  "devDependencies": { "@types/bun": "^1.2.0", "typescript": "^5.7.0" }
}
